# Groq API key from https://console.groq.com (never commit your real secret key to Git)
GROQ_API_KEY=your_groq_api_key_here

# Fast, high-accuracy production models on Groq:
# Option 1: groq/llama-3.3-70b-versatile (Recommended: best reasoning & tool use)
# Option 2: groq/llama-3.1-8b-instant (Fastest: ultra low latency on free tier)
MODEL_NAME=groq/llama-3.3-70b-versatile

# Server configuration
APP_HOST=0.0.0.0
APP_PORT=8000

# Set to true during local development for verbose debug output
DEBUG=false

# CrewAI execution timeout in seconds
CREW_TIMEOUT_SECONDS=120
