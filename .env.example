# Groq API key from https://console.groq.com (never commit the real value)
GROQ_API_KEY=your_groq_api_key_here

# CrewAI model string used by crew.py
MODEL_NAME=groq/openai/gpt-oss-120b

# Server settings
APP_HOST=127.0.0.1
APP_PORT=8000

# Set to true only during local development (verbose logs, auto-reload)
DEBUG=false

# Optional: seconds before /chat gives up on the crew
CREW_TIMEOUT_SECONDS=120